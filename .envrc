# Relocate direnv's devshell state (the nix-direnv flake profile and the
# `flake-inputs/` store mirrors, which include a read-only copy of this repo's
# source) under `build/` instead of the default `./.direnv`.
#
# Why `build/`: it is this project's gitignored Gradle generated-output
# directory — the least confusing "not source" location for a future reader —
# and `build` is one of kotlin-language-server's hard-coded source exclusions,
# so the Kotlin LSP skips everything under it for free. Left at `./.direnv`,
# the store mirror is indexed as a second copy of the repo, doubling every
# symbol reference and bloating the index.
direnv_layout_dir="$PWD/build/.direnv"

use flake
